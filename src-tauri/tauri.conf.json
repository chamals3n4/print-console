{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Print Console",
  "version": "2.0.0",
  "identifier": "io.github.chamals3n4.printconsole",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Print Console",
        "width": 1200,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["cups", "poppler-utils"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
